# ============================================================
# SIH PS-26188 — AI-Based Fake Identity & Document Screening
# Environment Configuration Template
# ============================================================
# IMPORTANT: Copy this to .env and replace all CHANGE_ME values.
# Never commit .env with real secrets.

# --- Server Bindings ---
HOST=0.0.0.0
PORT=8000

# --- Security & Authentication ---
# REQUIRE_AUTH=true is the PRODUCTION DEFAULT. Authentication is mandatory.
# Set to false only in full offline/local dev environments.
REQUIRE_AUTH=true

# DEV_MODE=true bypasses authentication entirely for local development.
# DO NOT enable in any shared or public environment.
DEV_MODE=false

# API keys (comma-separated). Change before any demo or deployment.
API_KEYS=CHANGE_ME_api_key_1,CHANGE_ME_api_key_2

# JWT secret. Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_replace_with_64_char_random_hex

# Fernet data encryption key for PII fields.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=CHANGE_ME_replace_with_fernet_key

# Evidence retention (days before purge)
EVIDENCE_RETENTION_DAYS=30

# --- Database ---
# SQLite (default, no setup required):
DATABASE_URL=sqlite:///dataset/screening_v2.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/screening_db

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=15

# --- Risk Scoring Weights (must sum to 1.0) ---
RISK_WEIGHT_VALIDATION=0.25
RISK_WEIGHT_TAMPERING=0.35
RISK_WEIGHT_FACE_MISMATCH=0.25
RISK_WEIGHT_REGISTRY=0.15
